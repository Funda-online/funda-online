# Copier ce fichier en .env.local et renseigner les valeurs.

# Sanity (publiques : visibles dans le navigateur)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-09-06

# URL publique du site, sans "/" final (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://funda-online.com

# Code de vérification Google Search Console (balise meta, valeur du "content")
GOOGLE_SITE_VERIFICATION=

# Secret partagé avec le webhook Sanity → /api/revalidate (serveur uniquement)
SANITY_REVALIDATE_SECRET=
